# OFFLINE / NO-EGRESS POSTURE (OFFLINE-01, D-03).
# Copy to .env and fill for local OFFLINE dev. NEVER commit real secrets.
#
# "Offline" here means NO cloud-hosted LLM inference egress — Vertex AI,
# Anthropic-direct, and the Cloudflare AI Gateway model path are all blanked
# below. It does NOT mean blocking all outbound network: local Postgres,
# self-hosted Langfuse, in-stack service-DNS model backends (vllm:8000,
# ollama:11434), and SaaS tool-pack adapters reaching their own APIs all stay
# legitimate. This posture zeroes ONLY the cloud-LLM/gateway creds; SaaS /
# tool-pack creds (COMPOSIO_API_KEY, BITSCALE_API_KEY) are left NORMAL.
#
# IMPORTANT — the local model api_base is NOT a new env var. Zero-`src/`
# forbids a new runtime env read, so OFFLINE is asserted-over-config +
# documented, never a runtime switch. The local model endpoint comes from the
# `make use-vllm` / `make use-ollama` profile FILE-SWAP (it copies the loopback
# model_gateway.vllm.yaml / .ollama.yaml over the active config), not from any
# value in this file. Express the posture with:
#     cp .env.offline.example .env && make use-vllm   # (or: make use-ollama)
# Verify it with `make test` (profile sweep + compose-env sweep + deny-guard)
# and, for the durable zero-`src/` guardrail, `ZERO_SRC_BASE=<sha> make test`.

# Deployment identity
TENANT_ID=tenant-example
CLIENT_SLUG=example-client
REGION=australia-southeast1
PROJECT_ID=REPLACE_WITH_GCP_PROJECT_ID

# Dispatch / persistence. Leave USE_PUBSUB=false to run fully in-process for
# local smoke checks. The DSN defaults below are DEV-ONLY local creds that match
# the `make run-pg` container (postgres:postgres@localhost:5432/agent_mesh) so
# `make test-pg` works out of the box; copy this file to an untracked .env and
# replace them for any real deployment (prod secrets come from Secret Manager).
# Local Postgres is LEGITIMATE under the offline posture — it is not cloud-LLM egress.
USE_PUBSUB=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_mesh
# DSN-gated `make test-pg` durable lane var (loud-skips when unset). Same dev-only
# local pgvector DSN as DATABASE_URL above.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_mesh
TASK_TOPIC=agent-mesh-tasks
APPROVAL_TOPIC=agent-mesh-approvals
DLQ_TOPIC=agent-mesh-dlq

# Model gateway (LiteLLM-compatible control plane). Under the OFFLINE posture
# MODEL_GATEWAY_BASE_URL stays LOCAL (loopback) and the upstream cloud path
# (Cloudflare AI Gateway -> Vertex/Anthropic) is left blank below — the local
# model api_base is supplied by the use-vllm/use-ollama file-swap, NOT here.
MODEL_GATEWAY_BASE_URL=http://localhost:4000
MODEL_PROVIDER_MODE=mixed
MODEL_ROUTE_PROFILE=mixed-cascade
MODEL_MAX_TOKENS=4096
MODEL_MONTHLY_BUDGET_USD=50

# Langfuse observability (default required platform for this variant).
# Self-host default for local dev; use https://cloud.langfuse.com for Langfuse Cloud.
# Self-hosted Langfuse on loopback is LEGITIMATE under the offline posture.
#
# Full-stack compose note (COMPOSE-02): under `make compose-up` the in-stack host
# overrides are applied by docker-compose `environment:` inline — DATABASE_URL ->
# @postgres, LANGFUSE_HOST -> @langfuse-web — so these loopback defaults are for the
# host run-targets, NOT the compose stack. The Langfuse SERVER secrets
# (NEXTAUTH_SECRET/SALT/ENCRYPTION_KEY/clickhouse/redis/minio) and the sandbox knobs
# (MESH_SBX_DIR/DOCKER_GID) live compose-inline (# CHANGEME), not as mesh .env keys.
LANGFUSE_HOST=http://localhost:3000

# Secret NAMES only — values come from Secret Manager / local .env, not here.
SLACK_SIGNING_SECRET=
# Approval-token signing secret. The approval gate FAILS CLOSED when this is
# unset: every POST /v1/approvals and MCP submit_approval is rejected (401).
# Set this locally to exercise the approval flow (UNLIKE Slack, which fails open
# in dev). In GCP this maps to a Secret Manager entry.
APPROVAL_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# --- Cloud-LLM / gateway creds: BLANK under the OFFLINE posture (no cloud egress) ---
MODEL_GATEWAY_MASTER_KEY=
MODEL_GATEWAY_SHARED_SECRET=
CF_AIG_WRAPPER_URL=
ANTHROPIC_API_KEY=
VERTEX_PROJECT_ID=
# Blanked under OFFLINE (carries `australia-southeast1` in .env.example — a VALUE
# the valued-key sweep would flag as cloud-LLM egress config).
VERTEX_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Tool-pack aggregator credentials (Phase 4/5). LEFT NORMAL under the offline
# posture — these reach the SaaS providers' own APIs, not a cloud LLM, and are
# out of scope for the no-cloud-LLM-egress restriction. Composio Tool Router
# brokers Xero OAuth; standard API key, proxy-execute disabled. Opt-in live lane only.
COMPOSIO_API_KEY=
# Bitscale direct adapter (Phase 5). REST base https://api.bitscale.ai/api/v1.
# run_grid is a write (burns credits) -> approval-gated; absent -> stub.
BITSCALE_API_KEY=
