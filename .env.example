# Copy to .env and fill for local dev. NEVER commit real secrets.
# In GCP, these map to Secret Manager entries wired via --set-secrets at deploy.

# Deployment identity
TENANT_ID=tenant-example
CLIENT_SLUG=example-client
REGION=australia-southeast1
PROJECT_ID=REPLACE_WITH_GCP_PROJECT_ID

# Dispatch / persistence. Leave USE_PUBSUB=false and DATABASE_URL empty to run
# fully in-process for local smoke checks.
USE_PUBSUB=false
DATABASE_URL=
TASK_TOPIC=agent-mesh-tasks
APPROVAL_TOPIC=agent-mesh-approvals
DLQ_TOPIC=agent-mesh-dlq

# Model gateway (LiteLLM-compatible control plane -> Cloudflare AI Gateway ->
# providers). Both Anthropic-direct and Vertex AI paths are first class.
MODEL_GATEWAY_BASE_URL=http://localhost:4000
MODEL_PROVIDER_MODE=mixed
MODEL_ROUTE_PROFILE=mixed-cascade
MODEL_MAX_TOKENS=4096
MODEL_MONTHLY_BUDGET_USD=50

# Langfuse observability (default required platform for this variant).
LANGFUSE_HOST=https://cloud.langfuse.com

# Secret NAMES only — values come from Secret Manager / local .env, not here.
SLACK_SIGNING_SECRET=
# Approval-token signing secret. The approval gate FAILS CLOSED when this is
# unset: every POST /v1/approvals and MCP submit_approval is rejected (401).
# Set this locally to exercise the approval flow (UNLIKE Slack, which fails open
# in dev). In GCP this maps to a Secret Manager entry.
APPROVAL_SIGNING_SECRET=
SLACK_BOT_TOKEN=
MODEL_GATEWAY_MASTER_KEY=
MODEL_GATEWAY_SHARED_SECRET=
CF_AIG_WRAPPER_URL=
ANTHROPIC_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=australia-southeast1
GOOGLE_APPLICATION_CREDENTIALS=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Tool-pack aggregator credentials (Phase 4/5). Composio Tool Router brokers
# Xero OAuth; standard API key, proxy-execute disabled. Opt-in live lane only.
COMPOSIO_API_KEY=
# Bitscale direct adapter (Phase 5). REST base https://api.bitscale.ai/api/v1.
# run_grid is a write (burns credits) -> approval-gated; absent -> stub.
BITSCALE_API_KEY=
