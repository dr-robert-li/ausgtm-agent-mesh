# =============================================================================
# ausgtm-agent-mesh — local environment template
# Copy to .env and fill in real values. Never commit a populated .env.
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Postgres (pgvector) -----------------------------------------------------
# docker-compose default. Override for hosted Postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ausgtm_mesh
POSTGRES_USER=ausgtm
POSTGRES_PASSWORD=ausgtm
DATABASE_URL=postgresql+asyncpg://ausgtm:ausgtm@localhost:5432/ausgtm_mesh

# --- Temporal (local) --------------------------------------------------------
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ausgtm-mesh

# --- Model providers ---------------------------------------------------------
# Direct Anthropic Claude Agent SDK is the PRIMARY path.
ANTHROPIC_API_KEY=

# Bedrock fallback (optional). Standard AWS env vars are also honoured.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_ENABLED=false

# Vertex fallback (optional).
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_ENABLED=false

# --- Slack -------------------------------------------------------------------
# Socket Mode for local. Create an app at api.slack.com/apps.
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=

# --- Monday.com --------------------------------------------------------------
MONDAY_API_KEY=
MONDAY_DEFAULT_BOARD_ID=

# --- Google Sheets -----------------------------------------------------------
# Path to a service-account JSON inside the local dev box. Never commit it.
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_DEFAULT_SPREADSHEET_ID=

# --- tl;dv / external meeting artifacts --------------------------------------
TLDV_API_KEY=
TLDV_BASE_URL=https://pasta.tldv.io

# --- MCP ---------------------------------------------------------------------
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8765
MCP_AUTH_TOKEN=

# --- Observability ----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ausgtm-agent-mesh

# --- Policy defaults (override per-tenant in policy/*) -----------------------
SUPERVISOR_MAX_WAVES=3
SUPERVISOR_MAX_CHILDREN_PER_WAVE=5
SUPERVISOR_MAX_RECURSION_DEPTH=1
SUPERVISOR_MAX_TOTAL_SPAWNS=25
