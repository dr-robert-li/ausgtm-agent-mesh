{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "google_calendar_list_events.input",
  "description": "Input for the Google Calendar list-events read tool. READ-category: no approval required.",
  "type": "object",
  "x-tool-category": "read",
  "x-approval-required": false,
  "additionalProperties": false,
  "required": ["calendar_id"],
  "properties": {
    "calendar_id": { "type": "string", "minLength": 1, "description": "Calendar id to read (e.g. 'primary')." },
    "time_min": { "type": "string", "format": "date-time", "description": "Lower bound (inclusive) for event start." },
    "time_max": { "type": "string", "format": "date-time", "description": "Upper bound (exclusive) for event start." },
    "max_results": { "type": "integer", "minimum": 1, "maximum": 250, "default": 25 }
  }
}
