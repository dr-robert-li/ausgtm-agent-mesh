{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gmail_send.input",
  "description": "Input for the Gmail send tool. EXTERNAL_SEND-category: approval required. Permissive-by-design (D-05); recipient is a security-critical field and is validated.",
  "type": "object",
  "x-tool-category": "external_send",
  "x-approval-required": true,
  "additionalProperties": true,
  "required": ["to", "subject", "body"],
  "properties": {
    "to": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "email", "minLength": 3 },
      "description": "Recipient email addresses (security-critical: validated)."
    },
    "cc": {
      "type": "array",
      "items": { "type": "string", "format": "email" }
    },
    "subject": { "type": "string" },
    "body": { "type": "string" }
  }
}
