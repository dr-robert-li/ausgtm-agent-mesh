{
  "$defs": {
    "Entrypoint": {
      "description": "How a task entered the mesh. Slack and MCP are mirrored capabilities.",
      "enum": [
        "slack",
        "mcp",
        "api",
        "internal"
      ],
      "title": "Entrypoint",
      "type": "string"
    },
    "RequesterIdentity": {
      "additionalProperties": false,
      "description": "Normalized requester identity. Slack and MCP contexts are mapped onto\nthis shared shape so approvals can be routed back to the originating\nrequester regardless of entrypoint.",
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "entrypoint": {
          "$ref": "#/$defs/Entrypoint"
        },
        "mcp_subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MCP auth subject / principal, when entrypoint is MCP.",
          "title": "Mcp Subject"
        },
        "requester_id": {
          "description": "Stable mesh-internal requester id.",
          "title": "Requester Id",
          "type": "string"
        },
        "slack_channel_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slack Channel Id"
        },
        "slack_user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slack User Id"
        }
      },
      "required": [
        "requester_id",
        "entrypoint"
      ],
      "title": "RequesterIdentity",
      "type": "object"
    },
    "TaskState": {
      "description": "Canonical task lifecycle. Kept Temporal-ready: states map cleanly onto\ndurable-workflow signals if Temporal is introduced post-POC.",
      "enum": [
        "received",
        "queued",
        "planning",
        "running",
        "awaiting_approval",
        "approved",
        "rejected",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "TaskState",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Durable task state. Persisted before any long-running execution begins so\na worker can resume after restart or approval pause.",
  "properties": {
    "client_slug": {
      "title": "Client Slug",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "entrypoint": {
      "$ref": "#/$defs/Entrypoint"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "model_route_profile": {
      "default": "mixed-cascade",
      "title": "Model Route Profile",
      "type": "string"
    },
    "prompt": {
      "title": "Prompt",
      "type": "string"
    },
    "requester": {
      "$ref": "#/$defs/RequesterIdentity"
    },
    "result_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Summary"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/TaskState",
      "default": "received"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "client_slug",
    "entrypoint",
    "requester",
    "session_id",
    "prompt"
  ],
  "title": "TaskRecord",
  "type": "object"
}
