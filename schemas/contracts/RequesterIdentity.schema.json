{
  "$defs": {
    "Entrypoint": {
      "description": "How a task entered the mesh. Slack and MCP are mirrored capabilities.",
      "enum": [
        "slack",
        "mcp",
        "api",
        "internal"
      ],
      "title": "Entrypoint",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Normalized requester identity. Slack and MCP contexts are mapped onto\nthis shared shape so approvals can be routed back to the originating\nrequester regardless of entrypoint.",
  "properties": {
    "display_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Display Name"
    },
    "email": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Email"
    },
    "entrypoint": {
      "$ref": "#/$defs/Entrypoint"
    },
    "mcp_subject": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "MCP auth subject / principal, when entrypoint is MCP.",
      "title": "Mcp Subject"
    },
    "requester_id": {
      "description": "Stable mesh-internal requester id.",
      "title": "Requester Id",
      "type": "string"
    },
    "slack_channel_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Slack Channel Id"
    },
    "slack_user_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Slack User Id"
    }
  },
  "required": [
    "requester_id",
    "entrypoint"
  ],
  "title": "RequesterIdentity",
  "type": "object"
}
