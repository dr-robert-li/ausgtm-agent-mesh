{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One row per model call for cost attribution and month-to-date budget\nenforcement. LiteLLM is the enforcement point; this is the durable ledger.",
  "properties": {
    "budget_event_id": {
      "title": "Budget Event Id",
      "type": "string"
    },
    "budget_owner": {
      "description": "Per-user budget owner id.",
      "title": "Budget Owner",
      "type": "string"
    },
    "client_slug": {
      "title": "Client Slug",
      "type": "string"
    },
    "completion_tokens": {
      "default": 0,
      "title": "Completion Tokens",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "estimated_cost_usd": {
      "default": 0.0,
      "title": "Estimated Cost Usd",
      "type": "number"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "prompt_tokens": {
      "default": 0,
      "title": "Prompt Tokens",
      "type": "integer"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "client_slug",
    "budget_owner",
    "model"
  ],
  "title": "BudgetEvent",
  "type": "object"
}
